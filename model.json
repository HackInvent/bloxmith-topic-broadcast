{
  "kind": "topic_broadcast",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Topic Broadcast",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "input_1",
        "title": "In 1",
        "accepts": [
          "message/*"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "output_1",
        "title": "Out 1",
        "emits": [
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "topic": "workflow.events"
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 1,
    "max_outputs": 1,
    "default_input_accepts": [
      "message/*"
    ],
    "default_output_emits": [
      "message/*"
    ],
    "default_multiplicity": "many"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ]
  }
}
