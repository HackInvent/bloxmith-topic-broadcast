{
  "kind": "topic_broadcast",
  "title": "Topic Broadcast",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "input_1",
        "title": "In 1",
        "accepts": [
          "message/*"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "output_1",
        "title": "Out 1",
        "emits": [
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "topic": "workflow.events"
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 1,
    "max_outputs": 1,
    "default_input_accepts": [
      "message/*"
    ],
    "default_output_emits": [
      "message/*"
    ],
    "default_multiplicity": "many"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event"
  }
}
